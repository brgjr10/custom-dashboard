# Copy to .env and fill in. Never commit .env.

# Authentication. The server refuses to start unless both are set.
# Set ALLOW_ANONYMOUS=true to run without auth (not recommended).
AUTH_USER=
AUTH_PASS=
ALLOW_ANONYMOUS=false

PORT=4000

GITHUB_TOKEN=

# Uptime Kuma. The API key stays on the server; the browser never receives it.
UPTIME_KUMA_BASE_URL=http://192.168.4.90:3001
UPTIME_KUMA_API_KEY=
UPTIME_KUMA_SLUG=
# Extra hosts permitted for /api/uptime-kuma, comma separated.
UPTIME_KUMA_ALLOWED_HOSTS=

# Pi-hole. The password stays on the server; the browser never receives it.
PIHOLE_BASE_URL=http://192.168.4.90
PIHOLE_PASSWORD=
PIHOLE_ALLOWED_HOSTS=

# The default integrations run on the LAN, so private upstream addresses must be allowed.
ALLOW_PRIVATE_UPSTREAM=true

DOCKER_SOCKET=/var/run/docker.sock